// Jenkinsfile

pipeline {
    agent {
            kubernetes {
                label 'jenkins-jq-agent' // Matches the label in your pod template
            }
        }

    environment {
        CORTEX_API_URL = 'https://api-ms-cxsiamp.xdr.us.paloaltonetworks.com'
    }

    stages{
        stage('cortexcloud Scan') {
            steps {
                script {
                    withCredentials([string(credentialsId: 'ms-cxsiamp-cortex-cli-api-key', variable: 'CORTEX_API_KEY'), string(credentialsId: 'ms-cxsiamp-cortex-cli-api-key-id', variable: 'CORTEX_API_KEY_ID')]) {

                        sh 'echo workspace=$WORKSPACE'
                        sh 'echo "downloading cortexcli"'
                        sh '''
                            response=$(curl --location "$CORTEX_API_URL/public_api/v1/unified-cli/releases/download-link?os=linux&architecture=amd64" \
                                  --header "Authorization: $CORTEX_API_KEY" \
                                  --header "x-xdr-auth-id: $CORTEX_API_KEY_ID" \
                                  --silent)

                            crtx_resp=$(curl -s "$CORTEX_API_URL/public_api/v1/unified-cli/releases/download-link?os=linux&architecture=amd64" \
                                        -H "x-xdr-auth-id: ${CORTEX_API_KEY_ID}" -H "Authorization: ${CORTEX_API_KEY}") 
                            crtx_url=$(echo $crtx_resp | jq -r ".signed_url") 
                            curl -o cortexcli $crtx_url                         
                            chmod +x cortexcli
                            ./cortexcli --version
                        '''
    
                        try {
                            echo "Attempting to run Cortex CLI code scan..."
                            sh '''
                            set -x # Enable shell debug output

                            ./cortexcli \
                              --api-base-url "$CORTEX_API_URL" \
                              --api-key "$CORTEX_API_KEY" \
                              --api-key-id "$CORTEX_API_KEY_ID" \
                              code scan \
                              --directory "\$(pwd)" \
                              --repo-id kwan/vulnerableApp-CLI-jenkins \
                              --branch cicd-test \
                              --source "JENKINS" \
                              --create-repo-if-missing --upload-mode no-upload

                            echo "Cortex CLI scan command finished with."
                            set +x # Disable shell debug output
                            '''
                        } catch (err) {
                            echo "Caught error during Cortex CLI scan: ${err}"
                            throw err // Re-throw the error to fail the Jenkins build
                        }
                    }
                }
            }            
        }
    }
}
